# ==============================================================================
# Vox Self-Hosted Reference Stack Environment Template
#
# IMPORTANT:
# Keep this file and your populated .env.self-hosted outside git and client-readable
# configuration. Secrets are injected at runtime by the deployment orchestrator.
# ==============================================================================

# Database Configuration (PostgreSQL 17)
POSTGRES_DB=vox
POSTGRES_USER=vox
POSTGRES_PASSWORD=replace-with-secure-postgres-password
DATABASE_URL=postgres://vox:replace-with-secure-postgres-password@postgres:5432/vox

# Cache & Queues (Redis 7)
REDIS_URL=redis://redis:6379

# Vox Core Configuration
VOX_CORE_SERVICE_TOKEN=replace-with-64-char-hex-service-token
VOX_CORE_BIND_ADDRESS=0.0.0.0:3001
VOX_CORE_URL=http://core-api:3001

# Vox Bridge Configuration
VOX_BRIDGE_URL=http://bridge:3000

# Conformance Sandbox & Deterministic Testing
SANDBOX_SEED=seed-2026

# External Model & Provider Keys (optional for self-hosted sandbox, required for live external features)
# GEMINI_API_KEY=
# Optional status webhook custody key; required to enable webhook subscriptions.
# Generate once with `openssl rand -hex 32` and export in the Compose process
# environment, rather than putting it in this shared env_file.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
