api.voxagent.in {
	# Block scanner / bot probes
	@probes path /.env* /.git* /wp-* *.php /admin/*
	respond @probes 403

	# Admin routes to core-api
	handle /v1/admin/redis* {
		header Cache-Control "no-store"
		reverse_proxy core-api:3001
	}

	# Explicit Voice Bridge routes
	handle /bridge/* {
		reverse_proxy bridge:3000
	}
	handle /twilio/* {
		reverse_proxy bridge:3000
	}
	handle /ws* {
		reverse_proxy bridge:3000
	}
	handle /health* {
		reverse_proxy bridge:3000
	}
	handle /internal/* {
		reverse_proxy bridge:3000
	}
	handle_path / {
		reverse_proxy bridge:3000
	}

	# Default catch-all for unknown routes
	handle {
		respond "Not Found" 404
	}
}
