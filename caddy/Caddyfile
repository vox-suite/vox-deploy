api.voxagent.in {
	# Block scanner / bot probes
	@probe_paths path /.env* /.git* /wp-* *.php /admin/*
	@probe_headers header Next-Action *
	respond @probe_paths 403
	respond @probe_headers 403

	# Admin routes to core-api
	handle /v1/admin/redis* {
		header Cache-Control "no-store"
		reverse_proxy core-api:3001
	}

	# Host & Docker system telemetry
	handle /v1/admin/system* {
		header Cache-Control "no-store"
		reverse_proxy 172.18.0.1:3002
	}

	# Core public API (auth, me, tasks, devices, …)
	handle /v1/* {
		reverse_proxy core-api:3001
	}

	# Explicit Voice Bridge routes
	handle /bridge/* {
		reverse_proxy bridge:3000
	}
	handle /auth/* {
		reverse_proxy bridge:3000
	}
	handle /twilio/* {
		reverse_proxy bridge:3000
	}
	handle /health* {
		reverse_proxy bridge:3000
	}
	# Root landing route: strictly GET/HEAD to bridge
	@root_get {
		method GET HEAD
		path /
	}
	handle @root_get {
		reverse_proxy bridge:3000
	}

	# Default catch-all. /internal/* and /channels/* (service-to-service) are
	# deliberately not proxied: they are reachable only on the Docker network.
	handle {
		respond 404
	}
}
