api.callvox.in {
	# Block scanner / bot probes
	@probe_paths path /.env* /.git* /wp-* *.php /admin/*
	@probe_headers header Next-Action *
	respond @probe_paths 403
	respond @probe_headers 403

	# Host & Docker system telemetry
	handle /v1/admin/system* {
		header Cache-Control "no-store"
		reverse_proxy 172.18.0.1:3002
	}

	# Core public API (auth, me, tasks, devices, …)
	handle /v1/* {
		reverse_proxy core-api:3001
	}

	# Explicit Voice Bridge routes
	handle /bridge/* {
		reverse_proxy bridge:3000
	}
	handle /health {
		respond "ok" 200
	}

	# Default catch-all. /internal/* (service-to-service) is
	# deliberately not proxied: it is reachable only on the Docker network.
	handle {
		respond 404
	}
}
