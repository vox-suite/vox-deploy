#!/usr/bin/env bash
set -euo pipefail

name=$(basename "$0")
printf '%s %s\n' "$name" "$*" >>"$VOX_COMMAND_LOG"

case $name in
  flock)
    exit 0
    ;;
  sleep)
    exit 0
    ;;
  systemctl)
    if [[ ${1-} == is-active ]]; then
      [[ ${VOX_SYSTEMD_ACTIVE:-0} == 1 ]]
    fi
    ;;
  curl)
    [[ ${VOX_FAKE_FAILURE:-} != public-health ]]
    ;;
  python3)
    [[ ${VOX_FAKE_FAILURE:-} != host-bootstrap ]]
    ;;
  docker)
    printf 'docker-env CORE_IMAGE=%s BRIDGE_IMAGE=%s\n' "${CORE_IMAGE:-}" "${BRIDGE_IMAGE:-}" >>"$VOX_COMMAND_LOG"
    if [[ $* == *" login "* ]]; then
      read -r _ || true
    fi
    if [[ ${VOX_FAKE_FAILURE:-} == pull && $* == *" compose "*" pull"* ]]; then
      exit 1
    fi
    if [[ ${VOX_FAKE_FAILURE:-} == bridge-health && $* == *" up "*" bridge"* ]]; then
      exit 1
    fi
    if [[ ${VOX_FAKE_FAILURE:-} == database-preflight && $* == *"vox-core-check-database"* ]]; then
      exit 1
    fi
    if [[ $* == *" ps -q core-worker"* ]]; then
      echo test-worker-container
    fi
    if [[ ${1-} == inspect ]]; then
      if [[ ${VOX_FAKE_FAILURE:-} == worker-exit ]]; then
        echo 'exited 0'
      elif [[ ${VOX_FAKE_FAILURE:-} == worker-restart ]] && grep -q '^sleep 10' "$VOX_COMMAND_LOG"; then
        echo 'running 1'
      else
        echo 'running 0'
      fi
    fi
    ;;
  *)
    echo "unsupported fake command: $name" >&2
    exit 1
    ;;
esac
